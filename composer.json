{
  "name": "owebstudio/kirby-google-translate",
  "description": "Google Translate integration for Kirby.",
  "type": "kirby-plugin",
  "license": "proprietary",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-plugin",
    "kirby-google-translate",
    "google-translate"
  ],
  "homepage": "https://github.com/owebstudio/kirby-google-translate",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Oweb\\GoogleTranslate\\": "src/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-iconv": "*",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "owebstudio/kirby-license": "^1.0.1"
  },
  "conflict": {
    "getkirby/cms": "<5.0"
  },
  "extra": {
    "installer-name": "kirby-google-translate",
    "kirby": {
      "compatible": "^5.0 || ^6.0"
    }
  },
  "prefer-stable": true
}
